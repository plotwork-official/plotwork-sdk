{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "ONE dispatcher per event runs every enabled check in .standards/claude/enforcement/checks/. Toggle checks in .standards.json -> enforcement.checks. Adding or removing a check never touches this file.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.standards/claude/enforcement/dispatch.py" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.standards/claude/enforcement/dispatch.py" }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.standards/claude/enforcement/dispatch.py" }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.standards/claude/enforcement/dispatch.py" }] }]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.ssh/**)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(chmod 777:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(uv publish:*)",
      "Bash(twine upload:*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm check:*)"
    ]
  }
}
