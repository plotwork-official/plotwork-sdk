# Sign in with Plotwork. Register a confidential app at https://app.plotwork.dev (Developers, then Developer apps) with the redirect
# address http://localhost:3000/auth/plotwork/callback. Server only: never prefix any of these with NEXT_PUBLIC_.
PLOTWORK_CLIENT_ID=
PLOTWORK_CLIENT_SECRET=

# This app's own address, for the redirect address: http://localhost:3000 in development.
APP_URL=

# Seals the session cookie. At least 32 characters: openssl rand -base64 32
SESSION_SECRET=

# Your Plotwork API key, from https://app.plotwork.dev (Keys), for the playground. Server only: never prefix it with NEXT_PUBLIC_.
PLOTWORK_API_KEY=

# Optional. The API to call and sign in with: https://api.plotwork.dev (the default) or https://api-preview.plotwork.dev.
PLOTWORK_BASE_URL=

# Optional. A stable link to follow live, such as https://cdn.plotwork.dev/l/<token>.svg. It is public, so it may reach the browser.
NEXT_PUBLIC_PLOTWORK_STABLE_LINK=
