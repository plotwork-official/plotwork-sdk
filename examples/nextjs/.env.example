# Your Plotwork API key, from https://app.plotwork.dev (Keys). Server only: never prefix it with NEXT_PUBLIC_.
PLOTWORK_API_KEY=

# Optional. The API to call: https://api.plotwork.dev (the default) or https://api-preview.plotwork.dev.
PLOTWORK_BASE_URL=

# Optional. A stable link to follow live, such as https://cdn.plotwork.dev/l/<token>.svg. It is public, so it may reach the browser.
NEXT_PUBLIC_PLOTWORK_STABLE_LINK=
