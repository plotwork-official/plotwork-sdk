# Your Plotwork API key, from https://app.plotwork.dev (Keys). Read by the dev server only: never prefix it with VITE_.
PLOTWORK_API_KEY=

# Optional. The API the dev server forwards to: https://api.plotwork.dev (the default) or https://api-preview.plotwork.dev.
PLOTWORK_BASE_URL=

# Optional. A stable link to follow live, such as https://cdn.plotwork.dev/l/<token>.svg. It is public, so it may reach the browser.
VITE_PLOTWORK_STABLE_LINK=

# Optional. Sign in with Plotwork: the client id of a public app registered at https://app.plotwork.dev (Developers, then Developer
# apps) with the redirect address http://localhost:5173/callback. A public app has no secret, so the id may be in the bundle.
VITE_PLOTWORK_CLIENT_ID=

# Optional. The API the page signs in with and reads the library from: https://api.plotwork.dev (the default) or
# https://api-preview.plotwork.dev. Use the same one as the app was registered on.
VITE_PLOTWORK_BASE_URL=
